# 公開先がサブパス（GitHub Pages の https://<user>.github.io/<repo>/）のときだけ設定する
# ローカル開発では空のままでよい
NEXT_PUBLIC_BASE_PATH=

# 端末間の同期（Supabase）。公開版は GitHub Actions の Secrets から入る。ローカルは .env.local に書く
# anon key は公開してよい種類の鍵（表の読み書きは RPC 関数だけに限定し、家族コードが無いと何も読めない）
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
